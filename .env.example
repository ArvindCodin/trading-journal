# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.

# MongoDB Atlas connection string (free M0 cluster works).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=trading_journal

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Change this if Google retires the default model.
GEMINI_MODEL=gemini-3.8-flash

# The password you type on the login page.
APP_PASSWORD=pick-something-long

# Random string used to sign the login cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
